# ============================================================================
# 环境变量示例（复制为 .env 后按需修改）
#
# 配置分三层，优先级从低到高：**代码默认 → .env（本文件）→ 数据库覆盖**。
# 下面这些是"启动前就该定下来"的项；倍速、心跳区间、并发数、模型名这类
# **运行时业务参数**可以不改这里 —— 用网页设置页或 `cx settings set` 改，
# 它们写在数据库里，重启不丢。
#
# 嵌套字段用双下划线：APP__HOST 对应 app.host
# ============================================================================

# ---------------------------------------------------------------------------
# 服务
# ---------------------------------------------------------------------------
# 本机开发用 127.0.0.1；服务器部署可以绑 0.0.0.0（由 Nginx 反代）
APP__HOST=127.0.0.1
APP__PORT=8000
APP__LOG_LEVEL=INFO

# 对外监听时的准入令牌（机器凭证，给 curl / 运维脚本用）。
# **安全约束**：HOST 不是回环地址且这里为空时，服务会拒绝启动 ——
# 这是刻意的：宁可起不来，也不要裸奔。
APP__API_TOKEN=

# 明确接受"对外监听且无鉴权"的风险（仅限可信内网）
APP__ALLOW_OPEN_ACCESS=false

# 是否允许公开注册。首个用户永远放行（否则新部署没人能授权）；
# 公网部署建议改成 false，账号由管理员在网页上创建。
APP__ALLOW_REGISTRATION=true

# 会话 Cookie 是否要求 HTTPS。**本地 http 调试必须为 false**，否则浏览器不回传 Cookie
APP__SECURE_COOKIES=false

# 开发期前端来源（`pnpm dev` 的端口）。生产同源托管时留空即可
# APP__CORS_ORIGINS=["http://127.0.0.1:5173"]

# 前端产物目录（默认仓库根的 web/dist，通常不用改）
# APP__WEB_DIST_DIR=

# 数据目录（数据库与日志都在它下面）
# APP__DATA_DIR=./data

# orca-cli 可执行文件（协议抓包 `cx dev capture browser` 与网页检查 `scripts/web_check.sh` 都走它）
# 留空则从 PATH 上找 `orca`
# APP__ORCA_BIN=

# ---------------------------------------------------------------------------
# 密钥（首次启动若为空会自动生成并回写本文件 —— 但请主动备份它）
#
# ⚠️ 换了密钥，库里所有密文（账号密码、会话快照）**永久解不开**。
#    迁移机器时把它一起带走。
# ---------------------------------------------------------------------------
SECRET_KEY=

# ---------------------------------------------------------------------------
# 学习通行为参数（这些也都能在网页/`cx settings set` 里热改）
# ---------------------------------------------------------------------------
# 播放倍速：服务端按真实时间核对进度，必须 1.0
CHAOXING__VIDEO_RATE=1.0
# 心跳间隔区间（秒）：太快容易被频控，太慢会拖长任务
CHAOXING__HEARTBEAT_INTERVAL_MIN=12.0
CHAOXING__HEARTBEAT_INTERVAL_MAX=20.0
# 单次上报的进度上限（秒），防止"一步跳到结尾"被判定为异常
CHAOXING__MAX_PROGRESS_STEP=40.0
# 同一账号两次请求的最小间隔（全局节流，别把账号搞进风控）
CHAOXING__REQUEST_MIN_INTERVAL=1.2
# 缺一题就不交卷（服务端接受部分答案但记 0 分，任务点却会变完成）
CHAOXING__QUIZ_REQUIRE_FULL_ANSWERS=true
# 同时刷几个账号（4C4G 预算下 3 是个稳妥值）
CHAOXING__MAX_ACCOUNT_CONCURRENCY=3
# 需要验证码时的策略：manual=停下来等人（默认）
CHAOXING__CAPTCHA_MODE=manual
# 出网代理（可选，例如 http://127.0.0.1:7890）
CHAOXING__PROXY=
# jhao104/proxy_pool sidecar API（可选；空 = 不启用）。
# 启用后周期拉取 /all/?type=https，403 时自动 /delete/ 淘汰坏出口。
CHAOXING__PROXY_POOL_API=
CHAOXING__PROXY_POOL_REFRESH_S=120
CHAOXING__PROXY_POOL_TIMEOUT=5
# 主动轮换：不等 403；同一账号累计 N 个请求或粘性满 N 秒就换出口（0=关闭）
CHAOXING__PROXY_ROTATE_REQUESTS=80
CHAOXING__PROXY_ROTATE_SECONDS=1800

# ---------------------------------------------------------------------------
# 答案引擎（不填 API Key 时只读题库缓存，刷题会跳过 —— 不会报错）
# ---------------------------------------------------------------------------
AI__PROVIDER=openai
AI__BASE_URL=https://api.deepseek.com
AI__MODEL=deepseek-chat
AI__API_KEY=
AI__TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# 可观测性
# ---------------------------------------------------------------------------
# 日志输出 JSON 行（便于采集）；本地想看可读文本可设 false
OBS__LOG_JSON=true
# 日志目录（默认 <数据目录>/logs）
# OBS__LOG_DIR=
# SSE 每连接的缓冲上限（满了丢最旧 —— 慢客户端不能拖垮发布者）
OBS__SSE_BUFFER=500
